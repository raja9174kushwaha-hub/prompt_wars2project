# ElectionGuide AI – Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ── Google AI ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDaYJFLGjtQSYq-heKPUDen7zJHNb35XV4

# Gemini model (default: gemini-1.5-flash for speed + cost efficiency)
GEMINI_MODEL=gemini-1.5-flash

# ── Security ──────────────────────────────────────────────
# Comma-separated allowed origins for CORS (use * only in dev)
ALLOWED_ORIGINS=http://localhost:8080,https://your-cloud-run-url.run.app

# Comma-separated trusted hosts (* disables check – use specific hosts in prod)
TRUSTED_HOSTS=*

# ── App config ────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8080
